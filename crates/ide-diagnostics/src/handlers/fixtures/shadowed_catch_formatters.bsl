Функция СтрСоединить(Знач Значения, Знач Разделитель)
    Возврат "готово";
КонецФункции

Функция Строка(Значение)
    Значение = "";
    Возврат "готово";
КонецФункции

Процедура ПотерятьПриПовторномИсключении()
    Ошибки = Новый Массив;
    Попытка
        Обработать();
    Исключение
        Ошибки.Добавить(ОписаниеОшибки());
    КонецПопытки;
    ВызватьИсключение СтрСоединить(Ошибки, "; ");
КонецПроцедуры

Функция ПотерятьПриВозврате()
    Попытка
        Обработать();
    Исключение
        Ошибка = ОписаниеОшибки();
    КонецПопытки;
    Возврат Строка(Ошибка);
КонецФункции
