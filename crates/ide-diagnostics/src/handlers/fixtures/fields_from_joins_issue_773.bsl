// A: ordinary comparison of the joined table in ГДЕ (МЕЖДУ, =, В)
Процедура ФильтрВГде() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Док.Ссылка КАК Ссылка,
	|	Цены.Цена КАК Цена
	|ИЗ
	|	Документ.Заказ КАК Док
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Цены КАК Цены
	|		ПО Док.Номенклатура = Цены.Номенклатура
	|ГДЕ
	|	Цены.Период МЕЖДУ &Начало И &Конец";
	Запрос.Выполнить();
КонецПроцедуры

Процедура ФильтрВГдеРавно() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Док.Ссылка КАК Ссылка,
	|	Цены.Цена КАК Цена
	|ИЗ
	|	Документ.Заказ КАК Док
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Цены КАК Цены
	|		ПО Док.Номенклатура = Цены.Номенклатура
	|ГДЕ
	|	Док.Проведен
	|	И Цены.ТипЦен В (&ТипыЦен)";
	Запрос.Выполнить();
КонецПроцедуры

// B: ИНАЧЕ after КОГДА ЕСТЬNULL(Т.Поле, 0) = 0 ТОГДА 0
Процедура ИначеПослеЕстьNull() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(Курсы.Курс, 0) = 0
	|			ТОГДА 0
	|		ИНАЧЕ Док.Сумма * Курсы.Курс / Курсы.Кратность
	|	КОНЕЦ КАК СуммаРуб
	|ИЗ
	|	Документ.Заказ КАК Док
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК Курсы
	|		ПО Док.Валюта = Курсы.Валюта";
	Запрос.Выполнить();
КонецПроцедуры

// C: ТОГДА under a comparison of a NULL-propagating expression of the field
Процедура ТогдаПодФункцией() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА РАЗНОСТЬДАТ(ОС.ДатаНачала, &Дата, МЕСЯЦ) >= 0
	|			ТОГДА ОС.ЕжемесячныйИзнос
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Износ,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ОС.ДатаСписания, ДАТАВРЕМЯ(1, 1, 1)) <> ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА ОС.ДатаСписания
	|		ИНАЧЕ &Дата
	|	КОНЕЦ КАК Окончание
	|ИЗ
	|	Документ.Заказ КАК Док
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПараметрыОС КАК ОС
	|		ПО Док.ОсновноеСредство = ОС.ОсновноеСредство";
	Запрос.Выполнить();
КонецПроцедуры

// D: owner of its own tabular section, a third table in the query
Процедура ВладелецИТретьяТаблица() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Док.Дата КАК Дата,
	|	ЕСТЬNULL(Цены.Цена, 0) КАК Цена
	|ИЗ
	|	Документ.Заказ.Товары КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Заказ КАК Док
	|		ПО Товары.Ссылка = Док.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Цены КАК Цены
	|		ПО Товары.Номенклатура = Цены.Номенклатура";
	Запрос.Выполнить();
КонецПроцедуры
