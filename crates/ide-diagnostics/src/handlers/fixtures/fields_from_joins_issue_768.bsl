// 1. Табличная часть соединена со своим документом по Ссылка: строка документа есть всегда.
Функция СтрокиСРеквизитамиДокумента() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Заказ.Дата КАК Дата
	|ИЗ
	|	Документ.Заказ.Товары КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Заказ КАК Заказ
	|		ПО Товары.Ссылка = Заказ.Ссылка";
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

// 2. Ветка ТОГДА выполняется, только если строка присоединённой таблицы есть.
Функция СуммаБезНалога() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА Ставки.Ставка <> 0
	|			ТОГДА Товары.Сумма / Ставки.Ставка
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Сумма
	|ИЗ
	|	Документ.Заказ.Товары КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Ставки КАК Ставки
	|		ПО Товары.Номенклатура = Ставки.Номенклатура";
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

// 3. Поле присоединённой таблицы только в условии ГДЕ.
Функция ТоварыСоСтавкой(Ставка) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура
	|ИЗ
	|	Документ.Заказ.Товары КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Ставки КАК Ставки
	|		ПО Товары.Номенклатура = Ставки.Номенклатура
	|ГДЕ
	|	Ставки.Ставка = &Ставка";
	Запрос.УстановитьПараметр("Ставка", Ставка);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

// 4. NULL доходит до арифметики и до результата: здесь срабатывание по делу.
Функция СуммаСНалогом() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.Сумма * Ставки.Ставка КАК Сумма
	|ИЗ
	|	Документ.Заказ.Товары КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Ставки КАК Ставки
	|		ПО Товары.Номенклатура = Ставки.Номенклатура";
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

// 5. Контроль: ЕСТЬNULL.
Функция СуммаСНалогомЕстьNull() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.Сумма * ЕСТЬNULL(Ставки.Ставка, 0) КАК Сумма
	|ИЗ
	|	Документ.Заказ.Товары КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Ставки КАК Ставки
	|		ПО Товары.Номенклатура = Ставки.Номенклатура";
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции
