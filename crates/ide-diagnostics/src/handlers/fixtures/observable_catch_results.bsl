Функция ПреобразоватьОшибкуВРезультат()
    Попытка
        Обработать();
    Исключение
        Возврат Новый Структура("Ошибка", ОписаниеОшибки());
    КонецПопытки;
КонецФункции

Процедура УчестьПропуски(Элементы, Результат)
    Для Каждого Элемент Из Элементы Цикл
        Попытка
            Обработать(Элемент);
        Исключение
            Результат.Пропущено = Результат.Пропущено + 1;
            Продолжить;
        КонецПопытки;
    КонецЦикла;
КонецПроцедуры

Функция ПодсчитатьПропуски(Элементы)
    Пропущено = 0;
    Для Каждого Элемент Из Элементы Цикл
        Попытка
            Обработать(Элемент);
        Исключение
            Пропущено = Пропущено + 1;
            Продолжить;
        КонецПопытки;
    КонецЦикла;
    Возврат Пропущено;
КонецФункции

Процедура ОчиститьРесурсы(Первый, Второй)
    Ошибки = Новый Массив;
    Попытка
        Первый.Закрыть();
    Исключение
        Ошибки.Добавить(ОписаниеОшибки());
    КонецПопытки;
    Попытка
        Второй.Закрыть();
    Исключение
        Ошибки.Добавить(ОписаниеОшибки());
    КонецПопытки;
    Если Ошибки.Количество() > 0 Тогда
        ВызватьИсключение СтрСоединить(Ошибки, "; ");
    КонецЕсли;
КонецПроцедуры

Функция ПлатформенноеПреобразование(Строка)
    Попытка
        Обработать();
    Исключение
        Ошибка = ОписаниеОшибки();
    КонецПопытки;
    Возврат Строка(Ошибка);
КонецФункции
