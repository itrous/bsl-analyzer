Процедура ПрочитатьЦены()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ 1";
	// Порционное чтение необходимо для ограничения объёма обработки.
	// bsl-analyzer:disable-next-line CreateQueryInCycle
	Запрос.ВыполнитьПакет();
КонецПроцедуры

Процедура ПервыйОбход(Тарифы)
	Для Каждого Тариф Из Тарифы Цикл
		ПрочитатьЦены();
	КонецЦикла;
КонецПроцедуры

Процедура ВторойОбход(Тарифы)
	Пока Тарифы.Следующий() Цикл
		ПрочитатьЦены();
	КонецЦикла;
КонецПроцедуры
