Процедура ПрочитатьЦены()
	Запрос = Новый Запрос;
	Запрос.Выполнить();
КонецПроцедуры

Процедура ОбойтиДерево(Узел)
	ОбойтиДерево(Узел);
	ПрочитатьЦены();
КонецПроцедуры

Процедура Обработать(Узлы)
	Запрос = Новый Запрос;
	Для Каждого Узел Из Узлы Цикл
		Запрос.Выполнить();
		Запрос.ВыполнитьПакет();
		ПрочитатьЦены();
		ОбойтиДерево(Узел);
	КонецЦикла;
КонецПроцедуры
