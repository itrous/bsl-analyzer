Функция СоздатьПлатежныеПоручения(Задания) Экспорт

	Результат = Новый Структура("Созданные, Сообщения", Новый Массив, Новый Массив);
	Если Не ДоступенФинансовыйКонтроль() Тогда
		Результат.Сообщения.Добавить("Создание платежных поручений доступно только сотрудникам ПЭО.");
		Возврат Результат;
	КонецЕсли;

	Для Каждого Задание Из Задания Цикл
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Задание,
			"Номер, ПометкаУдаления, СтатусДокумента, СозданоПП, ДокументОснование");
		Если Реквизиты.ПометкаУдаления Тогда
			Результат.Сообщения.Добавить(СтрШаблон("Задание %1 помечено на удаление.", Реквизиты.Номер));
			Продолжить;
		КонецЕсли;
		Если Реквизиты.СозданоПП Или ЕстьПлатежноеПоручение(Реквизиты.ДокументОснование) Тогда
			Результат.Сообщения.Добавить(СтрШаблон("По заданию %1 платежное поручение уже создано.", Реквизиты.Номер));
			Продолжить;
		КонецЕсли;
		Если Реквизиты.СтатусДокумента <> Перечисления.СтатусыОбработки.Согласован Тогда
			Результат.Сообщения.Добавить(СтрШаблон("Задание %1: ПП можно создавать только по согласованным документам.",
				Реквизиты.Номер));
			Продолжить;
		КонецЕсли;

		НачатьТранзакцию();
		Попытка
			Блокировка = Новый БлокировкаДанных;
			Блокировка.Добавить("Документ.ЗаданиеНаПлатеж").УстановитьЗначение("Ссылка", Задание);
			Блокировка.Заблокировать();

			ЗаданиеОбъект = Задание.ПолучитьОбъект();
			ПП = Документы.ПлатежноеПоручение.СоздатьДокумент();
			ЗаполнитьПлатежноеПоручение(ПП, ЗаданиеОбъект);
			ПП.Записать(РежимЗаписиДокумента.Запись);

			ЗаданиеОбъект.ДокументОснование = ПП.Ссылка;
			ЗаданиеОбъект.СозданоПП = Истина;
			ЗаданиеОбъект.ОбменДанными.Загрузка = Истина;
			ЗаданиеОбъект.Записать(РежимЗаписиДокумента.Запись);
			ЗафиксироватьТранзакцию();
			Результат.Созданные.Добавить(ПП.Ссылка);
		Исключение
			ОтменитьТранзакцию();
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Задание на платеж.Создание платежного поручения'"),
				УровеньЖурналаРегистрации.Ошибка, Метаданные.Документы.ЗаданиеНаПлатеж, Задание,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			Результат.Сообщения.Добавить(СтрШаблон("Задание %1: не удалось создать платежное поручение: %2",
				Реквизиты.Номер, КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		КонецПопытки;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция УстановитьСтатусФК(Задание, Статус, Причина)

	Если Не ДоступенФинансовыйКонтроль() Тогда
		Возврат "Данный функционал доступен только для сотрудников ПЭО.";
	КонецЕсли;

	ТекущийСтатус = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Задание, "СтатусДокумента");
	Если Не СтатусДопускаетФК(ТекущийСтатус) Тогда
		Возврат СтрШаблон("Для статуса ""%1"" действие недоступно.", ТекущийСтатус);
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Блокировка.Добавить("Документ.ЗаданиеНаПлатеж").УстановитьЗначение("Ссылка", Задание);
		Блокировка.Заблокировать();
		ЗаданиеОбъект = Задание.ПолучитьОбъект();
		ЗаданиеОбъект.СтатусДокумента = Статус;
		ЗаданиеОбъект.ПЭО = Пользователи.ТекущийПользователь();
		Если ЗначениеЗаполнено(Причина) Тогда
			ЗаданиеОбъект.ПричинаОтклонения = Причина;
		КонецЕсли;
		ЗаданиеОбъект.Записать(РежимЗаписиДокумента.Запись);
		ЗафиксироватьТранзакцию();
	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Задание на платеж.Финансовый контроль'"),
			УровеньЖурналаРегистрации.Ошибка, Метаданные.Документы.ЗаданиеНаПлатеж, Задание,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат "";

КонецФункции

Процедура ЗавершитьЗагрузкуПараметров(Параметры, ХешСценария) Экспорт
	Если ЗагрузкаСправочников.РежимКомплектаНСИ(Параметры) Тогда
		ЗагрузкаСправочников.ПроверитьКонтекстКомплектаНСИ(Параметры);
	Иначе
		Параметры.КонтекстОбмена = Новый ХранилищеЗначения(
			ЗначениеИзСтрокиВнутр(Параметры.КонтекстОбмена));
		ПроверитьПараметрыРучнойПервоначальнойЗагрузки(Параметры, ХешСценария);
		НачатьТранзакцию();
		Попытка
			НастройкиПодготовки = ОбновлениеКонфигурации.НастройкиПодготовкиРучногоОбмена();
			Если НастройкиПодготовки.ВалютныйУчет Тогда
				БанковскиеСчетаВызовСервера.ВключитьВалютныйУчет();
			КонецЕсли;
			Если НастройкиПодготовки.Версионирование Тогда
				ВерсионированиеОбъектов.ВключитьВерсионированиеОбъекта(
					"Документ.ПоступлениеТоваровУслуг", "ВерсионироватьПриПроведении");
			КонецЕсли;
			ЗафиксироватьТранзакцию();
		Исключение
			Если ТранзакцияАктивна() Тогда
				ОтменитьТранзакцию();
			КонецЕсли;
			ВызватьИсключение;
		КонецПопытки;
		ПодготовитьРучнуюПервоначальнуюЗагрузку(Параметры, ХешСценария);
	КонецЕсли;
КонецПроцедуры
