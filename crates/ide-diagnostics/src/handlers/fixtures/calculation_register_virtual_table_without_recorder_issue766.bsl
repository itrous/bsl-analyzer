// 1. История сотрудника по другим документам: отбор в параметрах, регистратора нет.
Функция ОтработанноеВремяЗаПериод(Сотрудник, Организация, НачалоПериода, КонецПериода) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.ПериодДействия КАК ПериодДействия,
	|	Т.Результат КАК Результат
	|ИЗ
	|	РегистрРасчета.Начисления.ФактическийПериодДействия(
	|			Сотрудник = &Сотрудник
	|				И Организация = &Организация
	|				И ПериодДействия МЕЖДУ &НачалоПериода И &КонецПериода) КАК Т";
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

// 2. Свой документ исключён явно, условия в ГДЕ, параметров у таблицы нет.
Функция НачисленияДругихДокументов(Сотрудник) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Регистратор КАК Регистратор,
	|	Т.Результат КАК Результат
	|ИЗ
	|	РегистрРасчета.Начисления.ФактическийПериодДействия КАК Т
	|ГДЕ
	|	Т.Сотрудник = &Сотрудник
	|	И Т.Регистратор <> &Ссылка";
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

// 3. То же исключение, но в параметрах таблицы.
Функция НачисленияДругихДокументовВПараметрах(Сотрудник) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Регистратор КАК Регистратор,
	|	Т.Результат КАК Результат
	|ИЗ
	|	РегистрРасчета.Начисления.ФактическийПериодДействия(
	|			Сотрудник = &Сотрудник
	|				И Регистратор <> &Ссылка) КАК Т";
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

// 4. Контроль: отбор по своему регистратору.
Функция СвоиНачисления() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Результат КАК Результат
	|ИЗ
	|	РегистрРасчета.Начисления.ФактическийПериодДействия(Регистратор = &Ссылка) КАК Т";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции
