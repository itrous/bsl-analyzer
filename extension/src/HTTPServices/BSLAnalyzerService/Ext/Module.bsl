	Соответствия.Добавить(Новый Структура("Значение,Имя", Свойства.ПериодичностьРегистраСведений.День, "Day"));
	Соответствия.Добавить(Новый Структура("Значение,Имя", Свойства.ПериодичностьРегистраСведений.Месяц, "Month"));
	Соответствия.Добавить(Новый Структура("Значение,Имя", Свойства.ПериодичностьРегистраСведений.Квартал, "Quarter"));
	Соответствия.Добавить(Новый Структура("Значение,Имя", Свойства.ПериодичностьРегистраСведений.Год, "Year"));
	Соответствия.Добавить(Новый Структура("Значение,Имя", Свойства.ПериодичностьРегистраСведений.ПозицияРегистратора, "RecorderPosition"));
	Соответствия.Добавить(Новый Структура("Значение,Имя", Свойства.РежимЗаписиРегистра.Независимый, "Independent"));
	Соответствия.Добавить(Новый Структура("Значение,Имя", Свойства.РежимЗаписиРегистра.ПодчинениеРегистратору, "RecorderSubordinate"));
	Для Каждого Соответствие Из Соответствия Цикл
		Если ТипЗнч(Значение) = ТипЗнч(Соответствие.Значение) И Значение = Соответствие.Значение Тогда
			Возврат Соответствие.Имя;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция ИдентичностьПредопределенногоЗаполнения(Значение)
	Попытка
		МетаданныеЗначения = Метаданные.НайтиПоТипу(ТипЗнч(Значение));
		Если МетаданныеЗначения = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Если Метаданные.Справочники.Индекс(МетаданныеЗначения) < 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Если ТипЗнч(Значение) <> Тип("СправочникСсылка." + МетаданныеЗначения.Имя) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Если Значение.Пустая() Тогда
			Возврат Неопределено;
		КонецЕсли;
		Менеджер = Справочники[МетаданныеЗначения.Имя];
		Если Менеджер.ПолучитьИнициализациюПредопределенныхДанных() <> Истина Тогда
			Возврат Неопределено;
		КонецЕсли;
		Имя = ПрочитатьСвойствоМетаданных(Значение, "ИмяПредопределенныхДанных");
		Если ТипЗнч(Имя) <> Тип("Строка") ИЛИ ПустаяСтрока(Имя) Тогда
			Возврат Неопределено;
		КонецЕсли;
		ПолноеИмя = ПолучитьПолноеИмяПредопределенногоЗначения(Значение);
		Если ПолноеИмя <> МетаданныеЗначения.ПолноеИмя() + "." + Имя Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат Новый Структура("metadata_type,metadata_name,predefined_name,runtime_ref_uuid",
			"Catalog", МетаданныеЗначения.Имя, Имя, Строка(Значение.УникальныйИдентификатор()));
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции


Функция ЗначениеЗаполненияМетаданных(ОбъектМетаданных)
	Попытка
		Значение = ОбъектМетаданных.ЗначениеЗаполнения;
		Результат = Новый Структура("type_name,value,nil,fields", Неопределено, "", Ложь, Новый Массив);
		Если Значение = Неопределено Тогда
			Результат.nil = Истина;
			Возврат Результат;
		КонецЕсли;
		ТипXML = XMLТипЗнч(Значение);
		Если ТипXML = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Результат.type_name = "{" + ТипXML.URIПространстваИмен + "}" + ТипXML.ИмяТипа;
		Результат.value = XMLСтрока(Значение);
		Идентичность = ИдентичностьПредопределенногоЗаполнения(Значение);
		Если Идентичность <> Неопределено Тогда
			Результат.Вставить("runtime_predefined_identity", Идентичность);
		КонецЕсли;
		Возврат Результат;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

Функция СвойстваЧленаМетаданных(ОбъектМетаданных, Путь, Локаль)
	Свойства = Новый Структура("path", Путь);
	ДобавитьСинонимМетаданных(Свойства, ОбъектМетаданных, Локаль);
	Использование = ТехническоеЗначениеСвойстваМетаданных(ПрочитатьСвойствоМетаданных(ОбъектМетаданных, "Использование"));
	Если Использование <> Неопределено Тогда
		Свойства.Вставить("use_mode", Использование);
	КонецЕсли;
	Заполнение = ЗначениеЗаполненияМетаданных(ОбъектМетаданных);
	Если Заполнение <> Неопределено Тогда
		Свойства.Вставить("fill_value", Заполнение);
	КонецЕсли;
	Возврат Свойства;
КонецФункции

Функция ПризнакиУчетаПредопределенногоСчета(Счет, Признаки)
	Результат = Новый Массив;
	Для Каждого Признак Из Признаки Цикл
		Значение = ПрочитатьСвойствоМетаданных(Счет, Признак.Имя);
		Если ТипЗнч(Значение) <> Тип("Булево") Тогда
			Значение = Неопределено;
		КонецЕсли;
		Результат.Добавить(Новый Структура("name,enabled", Признак.Имя, Значение));
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ПредопределенныеСчетаМетаданных(ОбъектМетаданных)
	Попытка
		Имена = ОбъектМетаданных.ПолучитьИменаПредопределенных();
		// Чтение не должно инициировать автоматическое создание предопределенных данных.
		Если Имена.Количество() > 0 Тогда
			Менеджер = ПланыСчетов[ОбъектМетаданных.Имя];
			Если Менеджер.ПолучитьИнициализациюПредопределенныхДанных() <> Истина Тогда
				Возврат Неопределено;
			КонецЕсли;
		КонецЕсли;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Счета = Новый Массив;
	ЕстьНепрочитанные = Ложь;
	Для Каждого Имя Из Имена Цикл
		Идентичность = Новый Структура;
		Описание = Новый Структура("name,runtime_reference", Имя, Идентичность);
		Счета.Добавить(Описание);
		Попытка
			Ссылка = ПредопределенноеЗначение(ОбъектМетаданных.ПолноеИмя() + "." + Имя);
			Если Ссылка.Пустая() Тогда
				ЕстьНепрочитанные = Истина;
				Продолжить;
			КонецЕсли;
			// Идентификатор ссылки не является ItemID из конфигурационного Predefined.xml.
			Идентичность.Вставить("uuid", Строка(Ссылка.УникальныйИдентификатор()));
			Родитель = ПрочитатьСвойствоМетаданных(Ссылка, "Родитель");
			Если Родитель <> Неопределено Тогда
				ПустойРодитель = Родитель.Пустая();
				Идентичность.Вставить("parent_known_empty", ПустойРодитель);
				Если Не ПустойРодитель Тогда
					Идентичность.Вставить("parent_uuid", Строка(Родитель.УникальныйИдентификатор()));
				КонецЕсли;
			КонецЕсли;
			Поля = Новый Соответствие;
			Поля.Вставить("Код", "code");
			Поля.Вставить("Наименование", "description");
			Поля.Вставить("Забалансовый", "off_balance");
			Поля.Вставить("Порядок", "order");
			Для Каждого Поле Из Поля Цикл
				Описание.Вставить(Поле.Значение, ПрочитатьСвойствоМетаданных(Ссылка, Поле.Ключ));
			КонецЦикла;
			Вид = ПрочитатьСвойствоМетаданных(Ссылка, "Вид");
			Если ТипЗнч(Вид) = Тип("ВидСчета") Тогда
				Описание.Вставить("account_type", XMLСтрока(Вид));
			КонецЕсли;
			Описание.Вставить("accounting_flags", ПризнакиУчетаПредопределенногоСчета(Ссылка, ОбъектМетаданных.ПризнакиУчета));
			Субконто = Новый Массив;
			Описание.Вставить("ext_dimension_types", Субконто);
			Для Каждого СтрокаСубконто Из Ссылка.ВидыСубконто Цикл
				ОписаниеСубконто = Новый Структура;
				Субконто.Добавить(ОписаниеСубконто);
				Попытка
					ВидСубконто = СтрокаСубконто.ВидСубконто;
					ОписаниеСубконто.Вставить("runtime_ref_uuid", Строка(ВидСубконто.УникальныйИдентификатор()));
					МетаданныеВида = Метаданные.НайтиПоТипу(ТипЗнч(ВидСубконто));
					МенеджерВидов = ПланыВидовХарактеристик[МетаданныеВида.Имя];
					Если МенеджерВидов.ПолучитьИнициализациюПредопределенныхДанных() = Истина Тогда
						ИмяВидаСубконто = ПолучитьПолноеИмяПредопределенногоЗначения(ВидСубконто);
						ОписаниеСубконто.Вставить("predefined_name", ИмяВидаСубконто);
					Иначе
						ЕстьНепрочитанные = Истина;
					КонецЕсли;
				Исключение
					ЕстьНепрочитанные = Истина;
				КонецПопытки;
				ОписаниеСубконто.Вставить("turnover", ПрочитатьСвойствоМетаданных(СтрокаСубконто, "ТолькоОбороты"));
				ОписаниеСубконто.Вставить("predefined", ПрочитатьСвойствоМетаданных(СтрокаСубконто, "Предопределенное"));
				ОписаниеСубконто.Вставить("accounting_flags", ПризнакиУчетаПредопределенногоСчета(СтрокаСубконто, ОбъектМетаданных.ПризнакиУчетаСубконто));
			КонецЦикла;
		Исключение
			ЕстьНепрочитанные = Истина;
		КонецПопытки;
		Если Не Описание.Свойство("code") ИЛИ Описание.code = Неопределено Тогда
			ЕстьНепрочитанные = Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("accounts,unread", Счета, ЕстьНепрочитанные);
КонецФункции


Функция СвойстваОбъектаМетаданных(ОбъектМетаданных, Локаль)
	Свойства = Новый Структура("members", Новый Массив);
	ДобавитьСинонимМетаданных(Свойства, ОбъектМетаданных, Локаль);
	Правила = Новый Соответствие;
	Если Метаданные.Справочники.Индекс(ОбъектМетаданных) >= 0 Тогда
		Правила.Вставить("Иерархический", "hierarchical");
		Правила.Вставить("ВидИерархии", "hierarchy_type");
		Правила.Вставить("ТипКода", "code_type");
		Правила.Вставить("ДлинаКода", "code_length");
		Правила.Вставить("ДопустимаяДлинаКода", "code_allowed_length");
	ИначеЕсли Метаданные.РегистрыСведений.Индекс(ОбъектМетаданных) >= 0 Тогда
		Правила.Вставить("ПериодичностьРегистраСведений", "periodicity");
		Правила.Вставить("РежимЗаписи", "write_mode");
	КонецЕсли;
	Для Каждого Правило Из Правила Цикл
		Значение = ПрочитатьСвойствоМетаданных(ОбъектМетаданных, Правило.Ключ);
		Если ТипЗнч(Значение) <> Тип("Булево") И ТипЗнч(Значение) <> Тип("Число") Тогда
			Значение = ТехническоеЗначениеСвойстваМетаданных(Значение);
		КонецЕсли;
		Если Значение <> Неопределено Тогда
			Свойства.Вставить(Правило.Значение, Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Свойства;
КонецФункции

// Возвращает основные коллекции реквизитов объекта метаданных живой ИБ.
Функция СтруктураМетаданныхPOST(Запрос)
	Параметры = РазобратьJSON(Запрос.ПолучитьТелоКакСтроку());
	Если Не Параметры.Свойство("meta_type") ИЛИ Не Параметры.Свойство("name") Тогда
		Возврат ОтветОшибка(400, "meta_type and name are required");
	КонецЕсли;

	Попытка
		Коллекция = Метаданные[Параметры.meta_type];
	Исключение
		Возврат ОтветОшибка(400, "Unknown metadata type: " + Параметры.meta_type);
	КонецПопытки;
	Попытка
		ОбъектМетаданных = Коллекция.Найти(Параметры.name);
	Исключение
		Возврат ОтветОшибка(400, "Metadata type does not support lookup: " + Параметры.meta_type);
	КонецПопытки;
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат ОтветОшибка(404, "Metadata object not found");
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("name", ОбъектМетаданных.Имя);
	Результат.Вставить("full_name", ОбъектМетаданных.ПолноеИмя());
	Результат.Вставить("synonym", Строка(ОбъектМетаданных.Синоним));
	Локаль = ЛокальСинонимовМетаданных();
	Свойства = СвойстваОбъектаМетаданных(ОбъектМетаданных, Локаль);
	Результат.Вставить("read_properties", Свойства);
	ВидыЧленов = Новый Структура("СтандартныеРеквизиты,Реквизиты,Измерения,Ресурсы,ТабличныеЧасти", "StandardAttribute", "Attribute", "Dimension", "Resource", "TabularSection");
	ИменаКоллекций = Новый Массив;
	ИменаКоллекций.Добавить("СтандартныеРеквизиты");
	ИменаКоллекций.Добавить("Реквизиты");
	ИменаКоллекций.Добавить("Измерения");
	ИменаКоллекций.Добавить("Ресурсы");
	ИменаКоллекций.Добавить("ТабличныеЧасти");
	Для Каждого ИмяКоллекции Из ИменаКоллекций Цикл
		Контейнер = Новый Структура;
		Контейнер.Вставить(ИмяКоллекции);
		ЗаполнитьЗначенияСвойств(Контейнер, ОбъектМетаданных);
		КоллекцияРеквизитов = Контейнер[ИмяКоллекции];
		Если КоллекцияРеквизитов = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Элементы = Новый Массив;
		Для Каждого Элемент Из КоллекцияРеквизитов Цикл
			ПутьЧлена = Новый Массив;
			ПутьЧлена.Добавить(ВидыЧленов[ИмяКоллекции]);
			ПутьЧлена.Добавить(Элемент.Имя);
			Свойства.members.Добавить(СвойстваЧленаМетаданных(Элемент, ПутьЧлена, Локаль));
			Описание = Новый Структура;
			Описание.Вставить("name", Элемент.Имя);
			Описание.Вставить("synonym", Строка(Элемент.Синоним));
			Если ИмяКоллекции = "ТабличныеЧасти" Тогда
				РеквизитыТабличнойЧасти = Новый Массив;
				Для Каждого РеквизитТабличнойЧасти Из Элемент.Реквизиты Цикл
					ПутьРеквизита = Новый Массив;
					ПутьРеквизита.Добавить("TabularSection");
					ПутьРеквизита.Добавить(Элемент.Имя);
					ПутьРеквизита.Добавить("Attribute");
					ПутьРеквизита.Добавить(РеквизитТабличнойЧасти.Имя);
					Свойства.members.Добавить(СвойстваЧленаМетаданных(РеквизитТабличнойЧасти, ПутьРеквизита, Локаль));
					ОписаниеРеквизита = Новый Структура;
					ОписаниеРеквизита.Вставить("name", РеквизитТабличнойЧасти.Имя);
					ОписаниеРеквизита.Вставить("synonym", Строка(РеквизитТабличнойЧасти.Синоним));
					ОписаниеРеквизита.Вставить("type", Строка(РеквизитТабличнойЧасти.Тип));
					ВариантыТипа = Новый Массив;
					Для Каждого ТипВарианта Из РеквизитТабличнойЧасти.Тип.Типы() Цикл
						ВариантыТипа.Добавить(ОписаниеВариантаТипа(ТипВарианта));
					КонецЦикла;
					ОписаниеРеквизита.Вставить("typeVariants", ВариантыТипа);
					РеквизитыТабличнойЧасти.Добавить(ОписаниеРеквизита);
				КонецЦикла;
				Описание.Вставить("attributes", РеквизитыТабличнойЧасти);
			Иначе
				Описание.Вставить("type", Строка(Элемент.Тип));
				ВариантыТипа = Новый Массив;
				Для Каждого ТипВарианта Из Элемент.Тип.Типы() Цикл
					ВариантыТипа.Добавить(ОписаниеВариантаТипа(ТипВарианта));
				КонецЦикла;
				Описание.Вставить("typeVariants", ВариантыТипа);
			КонецЕсли;
			Элементы.Добавить(Описание);
		КонецЦикла;
		Результат.Вставить(ИмяКоллекции, Элементы);
	КонецЦикла;

	Если Метаданные.Перечисления.Индекс(ОбъектМетаданных) >= 0 Тогда
		ЗначенияПеречисления = Новый Массив;
		Для Каждого ЗначениеПеречисления Из ОбъектМетаданных.ЗначенияПеречисления Цикл
			ЗначенияПеречисления.Добавить(Новый Структура("name,synonym", ЗначениеПеречисления.Имя, Строка(ЗначениеПеречисления.Синоним)));
			ПутьЗначения = Новый Массив;
			ПутьЗначения.Добавить("EnumValue");
			ПутьЗначения.Добавить(ЗначениеПеречисления.Имя);
			Свойства.members.Добавить(СвойстваЧленаМетаданных(ЗначениеПеречисления, ПутьЗначения, Локаль));
		КонецЦикла;
		Результат.Вставить("enum_values", ЗначенияПеречисления);
	КонецЕсли;
	Если Метаданные.ПланыСчетов.Индекс(ОбъектМетаданных) >= 0 Тогда
		Счета = ПредопределенныеСчетаМетаданных(ОбъектМетаданных);
		Если Счета <> Неопределено Тогда
			Результат.Вставить("predefined_accounts", Счета.accounts);
			Результат.Вставить("predefined_unread", Счета.unread);
		КонецЕсли;
	КонецЕсли;
	Возврат ОтветJSON(Результат);
КонецФункции

#КонецОбласти

#Область ПроверкаМодуля

// Принимает только внутренний носитель от Rust caller после AST admission.
// Проверка размера/формата здесь не заменяет действующие права HTTP-сервиса.
Функция ПроверитьМодульPOST(Запрос)

	НачалоПроверки82747 = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ИмяНосителя82747 = "";
	ОбъектНосителя82747 = Неопределено;
	ЭтапПроверки82747 = "request";
	Результат82747 = Новый Структура;
	Результат82747.Вставить("carrier_format", "bsl-analyzer-synthetic-object/1");
	Результат82747.Вставить("request_id", "");
	Результат82747.Вставить("create_attempted", Ложь);
	Результат82747.Вставить("safe_mode_requested", Ложь);
	Результат82747.Вставить("created", Ложь);
	Результат82747.Вставить("native_error", Неопределено);
	Результат82747.Вставить("failure_code", Неопределено);
	Результат82747.Вставить("cleanup_complete", Истина);
	Результат82747.Вставить("cleanup_error", Неопределено);
	Результат82747.Вставить("duration_ms", 0);

	Попытка
		Тело82747 = Запрос.ПолучитьТелоКакДвоичныеДанные();
		Если Тело82747.Размер() > 3145728 Тогда
			ВызватьИсключение "Module check request exceeds the byte limit";
		КонецЕсли;
		Параметры82747 = РазобратьJSON(Запрос.ПолучитьТелоКакСтроку());
		Если ТипЗнч(Параметры82747) <> Тип("Структура") Тогда
			ВызватьИсключение "Module check request must be a JSON object";
		КонецЕсли;
		Идентификатор82747 = Неопределено;
		Формат82747 = Неопределено;
		НосительBase6482747 = Неопределено;
		Таймаут82747 = Неопределено;
		Если Не Параметры82747.Свойство("request_id", Идентификатор82747)
			ИЛИ ТипЗнч(Идентификатор82747) <> Тип("Строка")
			ИЛИ СтрДлина(Идентификатор82747) = 0
			ИЛИ СтрДлина(Идентификатор82747) > 64 Тогда
			ВызватьИсключение "Invalid module check request id";
		КонецЕсли;
		Результат82747.request_id = Идентификатор82747;
		Если Не Параметры82747.Свойство("carrier_format", Формат82747)
			ИЛИ Формат82747 <> "bsl-analyzer-synthetic-object/1" Тогда
			ВызватьИсключение "Unsupported internal module carrier format";
		КонецЕсли;
		Если Не Параметры82747.Свойство("epf_base64", НосительBase6482747)
			ИЛИ ТипЗнч(НосительBase6482747) <> Тип("Строка")
			ИЛИ СтрДлина(НосительBase6482747) = 0
			ИЛИ СтрДлина(НосительBase6482747) > 2796204 Тогда
			ВызватьИсключение "Invalid module carrier encoding or size";
		КонецЕсли;
		Если Не Параметры82747.Свойство("timeout_ms", Таймаут82747)
			ИЛИ ТипЗнч(Таймаут82747) <> Тип("Число")
			ИЛИ Таймаут82747 < 1
			ИЛИ Таймаут82747 > 30000
			ИЛИ Цел(Таймаут82747) <> Таймаут82747 Тогда
			ВызватьИсключение "Invalid module check timeout";
		КонецЕсли;

		ЭтапПроверки82747 = "decode";
		ДанныеНосителя82747 = Base64Значение(НосительBase6482747);
		Если ДанныеНосителя82747.Размер() = 0 ИЛИ ДанныеНосителя82747.Размер() > 2097152 Тогда
			ВызватьИсключение "Decoded module carrier exceeds the byte limit";
		КонецЕсли;
		ЭтапПроверки82747 = "write";
		ИмяНосителя82747 = ПолучитьИмяВременногоФайла("epf");
		ДанныеНосителя82747.Записать(ИмяНосителя82747);
		ЭтапПроверки82747 = "deadline";
		Если ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоПроверки82747 >= Таймаут82747 Тогда
			ВызватьИсключение "Module check deadline expired before Create";
		КонецЕсли;

		ЭтапПроверки82747 = "create";
		Результат82747.safe_mode_requested = Истина;
		Результат82747.create_attempted = Истина;
		ОбъектНосителя82747 = ВнешниеОбработки.Создать(ИмяНосителя82747, Истина);
		Результат82747.created = Истина;
		Если ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоПроверки82747 >= Таймаут82747 Тогда
			Результат82747.failure_code = "deadline_exceeded";
		КонецЕсли;
	Исключение
		Результат82747.native_error = ОшибкаПроверкиМодуля82747(ОписаниеОшибки(), ИмяНосителя82747);
		Если ЭтапПроверки82747 = "deadline" Тогда
			Результат82747.failure_code = "deadline_exceeded";
		ИначеЕсли ЭтапПроверки82747 <> "create" Тогда
			Результат82747.failure_code = ЭтапПроверки82747 + "_failed";
		КонецЕсли;
	КонецПопытки;

	ОбъектНосителя82747 = Неопределено;
	Если Не ПустаяСтрока(ИмяНосителя82747) Тогда
		Попытка
			ФайлНосителя82747 = Новый Файл(ИмяНосителя82747);
			Если ФайлНосителя82747.Существует() Тогда
				УдалитьФайлы(ИмяНосителя82747);
			КонецЕсли;
			ФайлНосителя82747 = Новый Файл(ИмяНосителя82747);
			Если ФайлНосителя82747.Существует() Тогда
				Результат82747.cleanup_complete = Ложь;
				Результат82747.cleanup_error = "Owned module carrier still exists after cleanup";
			КонецЕсли;
		Исключение
			Результат82747.cleanup_complete = Ложь;
			Результат82747.cleanup_error = Лев(ОшибкаПроверкиМодуля82747(ОписаниеОшибки(), ИмяНосителя82747), 512);
		КонецПопытки;
	КонецЕсли;
	Результат82747.duration_ms = Макс(0, ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоПроверки82747);
	Возврат ОтветJSON(Результат82747);

КонецФункции

Функция ОшибкаПроверкиМодуля82747(ТекстОшибки, ИмяСвоегоНосителя)
	Если Не ПустаяСтрока(ИмяСвоегоНосителя) Тогда
		ТекстОшибки = СтрЗаменить(ТекстОшибки, ИмяСвоегоНосителя, "<owned carrier>");
	КонецЕсли;
	Возврат Лев(ТекстОшибки, 4096);
КонецФункции

#КонецОбласти
